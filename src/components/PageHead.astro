---
import Button from '~/components/Button.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ButtonLink from './ButtonLink.astro';
import { twMerge } from 'tailwind-merge';

interface Props {
  pageTitle: string;
  title: string;
  subtitle: string;
  classes?: string;
  links?: {
    link: string;
    linkText?: string;
    target?: string;
  }[];
  image?: ImageMetadata;
}
const { pageTitle, title, subtitle, image, classes, links } = Astro.props;

const vacancies = await getCollection('vacancies');
const hasOpenedVacancies = !!vacancies.filter((v) => !v.data.disabled).length;
---

<div
  class={twMerge(
    'relative container mt-8 flex flex-col items-start justify-between pb-4 md:mt-24 md:flex-row',
    classes
  )}
>
  <div
    id="page-head-block__text"
    class={twMerge(
      'animate-page-head relative z-10 mb-4 max-w-227.5 md:mb-0',
      hasOpenedVacancies && !!links && 'mb-8'
    )}
  >
    <div class="">
      <div class="transparent-text md:text-9xl-desktop inline-block text-7xl">
        {pageTitle}
      </div>
    </div>
    <div
      class="md:text-7xl-desktop mb-4 text-4xl text-white md:mt-1.5"
      set:html={title}
    />
    <div class="md:text-xl-desktop text-xl font-normal! text-white opacity-80">
      {subtitle}
    </div>
    {
      links && (
        <div class="flex flex-col md:flex-row md:gap-6">
          {links.map((link) => (
            <ButtonLink
              href={link.link}
              target={link.target ? link.target : '_self'}
              variant="outlined"
              classes="px-3 lg:px-6 w-fit mt-8 md:mt-10"
              arrowClasses="-rotate-45"
            >
              {link.linkText ? link.linkText : 'Learn more'}
            </ButtonLink>
          ))}
        </div>
      )
    }
  </div>
  {
    hasOpenedVacancies && (
      <a href="#footer" class="md:hidden">
        <Button classes="md:text-xl-desktop rounded-2lg h-14 w-fit px-3 py-3 text-xl lg:px-6">
          Work with us
        </Button>
      </a>
    )
  }

  {
    image && (
      <Image
        class="hidden w-[30%] lg:block"
        format="webp"
        width={image.width}
        height={image.height}
        src={image}
        alt="top page background"
        fetchpriority="high"
        loading="eager"
      />
    )
  }
</div>
