---
import type { HTMLAttributes } from 'astro/types';
import ArrowRight from '~/assets/images/arrow-right.svg';
import { twMerge } from 'tailwind-merge';

interface Props extends HTMLAttributes<'a'> {
  classes?: string;
  arrowClasses?: string;
  href: string;
  variant?: 'outlined' | 'ghost';
}

const {
  classes,
  arrowClasses,
  href,
  variant = 'ghost',
  ...linkProps
} = Astro.props;
---

<a
  href={href}
  class:list={twMerge(
    'rounded-2lg md:text-xl-desktop inline-block px-6 py-3 text-center text-xl text-white hover:opacity-80',
    variant === 'outlined' && 'border border-white/60 hover:border-white',
    classes
  )}
  {...linkProps}
>
  <slot />
  <ArrowRight
    class:list={twMerge(
      'ml-3 inline-block h-7 w-7 fill-white md:h-8',
      arrowClasses
    )}
  />
</a>

<style></style>
