---
import Layout from '~/layouts/Layout.astro';
import PageHead from '~/components/PageHead.astro';
import servicesKeriBlockImage from '~/assets/images/services-keri-block.png';
import PersonVCardIcon from '~/assets/images/person-vcard.svg';
import ShieldLockIcon from '~/assets/images/shield-lock.svg';
import WalletIcon from '~/assets/images/wallet.svg';
import ShieldCheckIcon from '~/assets/images/shield-check.svg';
import RocketTakeoffIcon from '~/assets/images/rocket-takeoff.svg';
---

<Layout>
  <div class="mb-24 md:mb-[200px]">
    <PageHead
      pageTitle="KERI"
      title="Key Event Receipt Infrastructure (KERI)"
      subtitle="KERI is a powerful new decentralized identity protocol designed for security and data privacy - the first to combine key rotation and recovery with full infrastructure independence. No blockchains, no certificate authorities, no central registries."
      image={servicesKeriBlockImage}
      classes="[&>:nth-child(1)]:max-w-[740px]"
      links={[
        { link: 'https://keri.one/', linkText: 'keri.one', target: '_blank' },
        {
          link: 'https://keri.foundation/',
          linkText: 'keri.foundation',
          target: '_blank',
        },
      ]}
    />
  </div>
  <div class="container mt-24 pb-24 md:mt-32 md:pb-32">
    <div
      class="test relative flex shrink-0 grow-0 flex-col items-center justify-start self-stretch"
    >
      <div
        class="flex shrink-0 grow-0 flex-col items-start justify-start gap-1 self-stretch overflow-hidden"
      >
        <div
          class="flex shrink-0 grow-0 items-start justify-center gap-10 self-stretch rounded-tl-xl rounded-tr-xl bg-white/5 p-8"
        >
          <div class="flex grow flex-col items-start justify-start gap-4">
            <div
              class="relative flex shrink-0 grow-0 items-start justify-start self-stretch"
            >
              <p
                class="grow text-left text-xl font-semibold text-white md:text-3xl"
              >
                Engineering services to integrate <a
                  class="underline hover:opacity-80"
                  href="https://keri.one/"
                  target="_blank">KERI</a
                > into your solution. Swift can help you:
              </p>
            </div>
            <div
              class="flex shrink-0 grow-0 flex-col items-start justify-start gap-4 self-stretch"
            >
              <div
                class="flex shrink-0 grow-0 items-start justify-start gap-2 self-stretch"
              >
                <div
                  class="relative flex shrink-0 grow-0 items-center justify-start gap-2 pt-0.75"
                >
                  <PersonVCardIcon />
                </div>
                <div class="relative flex grow items-start justify-start">
                  <p class="grow text-left text-xl font-normal text-white">
                    Accept and verify KERI identifiers
                  </p>
                </div>
              </div>
              <div
                class="flex shrink-0 grow-0 items-start justify-start gap-2 self-stretch"
              >
                <div
                  class="relative flex shrink-0 grow-0 items-center justify-start gap-2 pt-0.75"
                >
                  <ShieldLockIcon />
                </div>
                <div class="relative flex grow items-start justify-start">
                  <p class="grow text-left text-xl font-normal text-white">
                    Issue KERI-compatible credentials with support for complex
                    delegation chains (organizational hierarchies, parental
                    authorization, guardian relationships)
                  </p>
                </div>
              </div>
              <div
                class="flex shrink-0 grow-0 items-start justify-start gap-2 self-stretch"
              >
                <div
                  class="relative flex shrink-0 grow-0 items-center justify-start gap-2 pt-0.75"
                >
                  <WalletIcon />
                </div>
                <div class="relative flex grow items-start justify-start">
                  <p class="grow text-left text-xl font-normal text-white">
                    Develop local-first KERI-compatible wallets that store
                    private keys in the Trusted Execution Environment (Android)
                    or the Secure Enclave API (iOS), while still allowing the
                    user to transport their KERI identity to other wallets.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="flex shrink-0 grow-0 items-start justify-start gap-10 self-stretch rounded-br-xl rounded-bl-xl bg-white/5 p-8"
        >
          <div class="flex grow flex-col items-start justify-start gap-4">
            <div
              class="relative flex shrink-0 grow-0 items-start justify-start self-stretch"
            >
              <p
                class="grow text-left text-xl font-semibold text-white md:text-3xl"
              >
                Swift is a contributor to the <a
                  class="underline hover:opacity-80"
                  href="https://privacy.utah.gov/wp-content/uploads/SEDI_ProtectingLiberty.pdf"
                  target="_blank">SEDI</a
                > initiative
              </p>
            </div>
            <div
              class="flex shrink-0 grow-0 flex-col items-start justify-start gap-4 self-stretch"
            >
              <div
                class="flex shrink-0 grow-0 items-start justify-start gap-2 self-stretch"
              >
                <div
                  class="relative flex shrink-0 grow-0 items-center justify-start gap-2 pt-0.75"
                >
                  <ShieldCheckIcon />
                </div>
                <div class="relative flex grow items-start justify-start">
                  <p class="grow text-left text-xl font-normal text-white">
                    State-Endorsed Digital Identity, or SEDI, is a framework for
                    digital identity built on a foundational principle: identity
                    belongs to the person, not the government. The government's
                    role is to endorse and protect identity, not to create or
                    control it. SEDI requires that individuals fully control
                    their digital identifiers.
                  </p>
                </div>
              </div>
              <div
                class="flex shrink-0 grow-0 items-start justify-start gap-2 self-stretch"
              >
                <div
                  class="relative flex shrink-0 grow-0 items-center justify-start gap-2 pt-0.75"
                >
                  <RocketTakeoffIcon />
                </div>
                <div class="relative flex grow items-start justify-start">
                  <p class="grow text-left text-xl font-normal text-white">
                    Although SEDI doesn’t mandate KERI technology, we believe it
                    is the best, and perhaps the only technology, that can meet
                    SEDI’s objectives without compromising on decentralization.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
<style>
  .test {
    background-image: url('/src/assets/images/ellipse.svg');
    background-size: cover;
    background-position: center;
  }
</style>
