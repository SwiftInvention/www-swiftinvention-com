---
import { Image } from 'astro:assets';
import aboutBackgroundImage from '~/assets/images/about/about-bg.png';
import ChatLeftQuoteImage from '~/assets/images/about/chat-left-quote.svg';
import GeoAltImage from '~/assets/images/about/geo-alt.svg';
import PeopleImage from '~/assets/images/about/people.svg';
import RocketTakeoffImage from '~/assets/images/about/rocket-takeoff.svg';
import ShieldCheckImage from '~/assets/images/about/shield-check.svg';
import ButtonLink from '~/components/ButtonLink.astro';
import ImageCarousel from '~/components/ImageCarousel.astro';
import type { ResponsiveImagesConfig } from '~/components/ResponsiveImage.astro';
import ResponsiveImage from '~/components/ResponsiveImage.astro';
import {
  ClientsAll,
  ProvidedServiceIdToIcon,
  type ClientPageProps,
} from '~/constants/clientsStack.astro';
import Layout from '../../layouts/Layout.astro';
import { twMerge } from 'tailwind-merge';

export async function getStaticPaths() {
  return ClientsAll.filter((c) => c.id).map((client) => ({
    params: { id: client.id },
    props: { client },
  }));
}

interface Props {
  client: ClientPageProps;
}

const { client } = Astro.props;
const {
  name,
  title,
  subtitle,
  logoImg,
  description,
  comments,
  links,
  pageTopImg,
  about,
  providedServices,
  technologies,
  screenshotsInfo,
} = client;

const pageImagesConfig =
  pageTopImg &&
  ([
    {
      image: pageTopImg.default,
      sourceProps: {
        media:
          '(-webkit-max-device-pixel-ratio: 1.25), (max-resolution: 1.25dppx)',
        type: 'image/webp',
      },
    },
    pageTopImg.x2 && {
      image: pageTopImg.x2,
      sourceProps: {
        type: 'image/webp',
        media: '(-webkit-max-device-pixel-ratio: 2), (max-resolution: 2dppx)',
      },
    },
  ].filter(Boolean) as ResponsiveImagesConfig);
---

<Layout>
  <div class="relative">
    <div
      class="relative container mt-8 mb-4 flex flex-col items-start justify-between md:mt-24 md:mb-32 md:flex-row"
    >
      <div class="relative z-10 mb-8 md:mb-0 md:w-[45%] lg:pt-11.25">
        <Image
          format="webp"
          src={logoImg}
          width={logoImg.width}
          height={logoImg.height}
          alt={`${name} logo`}
        />
        <div class="md:text-4xl-desktop my-4 text-4xl text-white">
          {title ?? description}
        </div>
        <div
          class="md:text-xl-desktop text-xl font-normal! text-white opacity-80"
        >
          {subtitle}
        </div>
        <div class="mt-8 flex flex-wrap gap-2 md:mt-10">
          {
            links?.map((link) => (
              <ButtonLink
                href={`https://${link}`}
                target="_blank"
                variant="outlined"
                arrowClasses="-rotate-45"
              >
                Visit {link}
              </ButtonLink>
            ))
          }
        </div>
      </div>
      {
        pageImagesConfig && (
          <div class="aspect-[1.14] w-full rounded-xl border border-white/[0.07] bg-white/[0.07] p-0.5 md:w-1/2 md:rounded-3xl md:p-4">
            <ResponsiveImage
              imagesConfig={pageImagesConfig}
              alt={`${name} image for top of the page`}
              format="webp"
              classes="w-full rounded-xl md:rounded-3xl"
              fetchPriority="high"
            />
          </div>
        )
      }
    </div>
    <Image
      format="webp"
      src={aboutBackgroundImage}
      class={twMerge(
        'absolute bottom-[-15%] left-0 z-[-1] h-[150%] w-screen',
        !screenshotsInfo && 'bottom-0'
      )}
      alt="About Us background"
    />
    <div class="container">
      <div class="relative mb-32 rounded-xl">
        <div class="overflow-hidden rounded-xl">
          <div class="flex flex-wrap gap-1 lg:flex-nowrap">
            <div
              class="flex grow basis-full flex-col gap-4 border border-white/[0.07] bg-white/5 p-6 md:p-8 lg:basis-1/3"
            >
              <div class="md:text-xl-desktop text-xl text-white">
                About {name}
              </div>
              <div
                class="md:text-xl-desktop flex items-start gap-2 text-xl font-normal! text-white"
              >
                <RocketTakeoffImage class="mt-0.75 h-6 w-6 min-w-6" />
                Founded in {about?.founded}
              </div>
              <div
                class="md:text-xl-desktop flex items-start gap-2 text-xl font-normal! text-white"
              >
                <PeopleImage class="mt-0.75 h-6 w-6 min-w-6" />
                {about?.employees} employees
              </div>
              <div
                class="md:text-xl-desktop flex items-start gap-2 text-xl font-normal! text-white"
              >
                <GeoAltImage class="mt-0.75 h-6 w-6 min-w-6" />
                {about?.location}
              </div>
              <div
                class="md:text-xl-desktop flex items-start gap-2 text-xl font-normal! text-white"
              >
                <ShieldCheckImage class="mt-0.75 h-6 w-6 min-w-6" />
                {about?.purpose}
              </div>
            </div>
            <div
              class="flex grow basis-full flex-col gap-4 border border-white/[0.07] bg-white/5 p-6 md:p-8 lg:basis-1/3"
            >
              <div class="md:text-xl-desktop text-xl text-white">
                Provided services
              </div>
              {
                providedServices?.map((service) => {
                  const Icon = ProvidedServiceIdToIcon[service.id];
                  return (
                    <div class="md:text-xl-desktop flex items-start gap-2 text-xl font-normal! text-white">
                      <Icon class="mt-0.75 h-6 w-6 min-w-6" />
                      {service.title}
                    </div>
                  );
                })
              }
            </div>
            {
              technologies && (
                <div class="flex grow basis-full flex-col gap-4 border border-white/[0.07] bg-white/5 p-4 md:p-8 lg:basis-1/3">
                  <div class="md:text-xl-desktop text-xl text-white">
                    Technology used
                  </div>

                  <div class="xs:grid-cols-2 grid grid-cols-1 gap-x-0.5 gap-y-4 lg:grid-cols-1 xl:grid-cols-2">
                    {technologies.map((technology) => {
                      const IconRendered = technology.object ? (
                        <Image
                          width={24}
                          height={24}
                          src={technology.object}
                          class="mt-1 inline-block h-6 w-6 min-w-6 object-contain"
                          alt={technology.title + ' logo'}
                        />
                      ) : (
                        <technology.SvgComponent class="inline-block h-6 w-6 min-w-6" />
                      );
                      return (
                        <div class="md:text-xl-desktop flex items-center gap-2 text-xl font-normal! text-white">
                          {IconRendered}
                          {technology.title}
                        </div>
                      );
                    })}
                  </div>
                </div>
              )
            }
          </div>
          {
            !!comments &&
              !!comments.length &&
              comments.map((comment, index) => (
                <div class="mt-1 flex basis-full flex-col gap-4 border border-white/[0.07] bg-white/5 p-6 md:p-8 lg:basis-1/3">
                  {index === 0 && <ChatLeftQuoteImage />}
                  <p class="md:text-3xl-desktop text-3xl leading-[1.6]! text-white italic">
                    {comment.text}
                  </p>
                  <div class="mt-6 flex gap-4 md:mt-10">
                    {comment.author.avatar && (
                      <Image
                        src={comment.author.avatar}
                        width={comment.author.avatar.width}
                        height={comment.author.avatar.height}
                        alt={name + '`s chief photo'}
                        class="h-16 w-16 rounded-[50%]"
                        format="webp"
                      />
                    )}
                    <div class="flex flex-col justify-center">
                      <div class="md:text-xl-desktop text-xl text-white">
                        {comment.author.name}
                      </div>
                      <div class="text-lg text-white">
                        {comment.author.position}
                      </div>
                    </div>
                  </div>
                </div>
              ))
          }
        </div>
      </div>
    </div>
  </div>
  {
    screenshotsInfo && (
      <ImageCarousel
        name={name}
        screenshotsInfo={screenshotsInfo}
        links={links}
      />
    )
  }
  {
    !screenshotsInfo && (
      <div class="container">
        <div class="flex flex-col gap-4 lg:flex-row">
          <div class="flex flex-col gap-2 xl:flex-row">
            {links?.map((link) => (
              <ButtonLink
                href={`https://${link}`}
                target="_blank"
                variant="outlined"
                classes="px-3 lg:px-6 w-full md:w-auto"
                arrowClasses="-rotate-45"
              >
                Visit {link}
              </ButtonLink>
            ))}
          </div>
          <ButtonLink
            href="/case-studies"
            variant="ghost"
            classes="w-full md:w-auto"
          >
            View more case studies
          </ButtonLink>
        </div>
      </div>
    )
  }
</Layout>
